# MeanVC2 Neural Voice Engine settings
# Copy relevant lines to backend/.env to activate

# Engine adapter: set to "meanvc2" to use neural VC
HTH_ENGINE_ADAPTER=meanvc2

# MeanVC2 model directory (defaults to %LOCALAPPDATA%\HTH\MeanVC2Models)
# HTH_MEANVC2_MODEL_DIR=C:\Users\YourName\AppData\Local\HTH\MeanVC2Models

# Compute device: "cpu" (always works) or "cuda" (requires NVIDIA GPU)
# HTH_MEANVC2_DEVICE=cpu

# Model variant: "40ms" (lower latency, ~110ms) or "120ms" (higher quality)
# HTH_MEANVC2_VARIANT=40ms
